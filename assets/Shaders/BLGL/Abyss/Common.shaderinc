// ============================================================================
// Abyss · 公共函数：哈希、带频率钳制的噪声、SDF 基本体
// 约定：世界单位为米，Y 轴向上；SDF 在物体外为正。
// ============================================================================

// PI、TAU、E 是着色语言内置常量，不要重复定义

// ---- 哈希（Dave Hoskins，无三角函数，各后端结果一致） ----
float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float hash13(vec3 p) {
    vec3 p3 = fract(p * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

// ---- 值噪声 ----
float vnoise2(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + vec2(1.0, 0.0));
    float c = hash12(i + vec2(0.0, 1.0));
    float d = hash12(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float vnoise3(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float n000 = hash13(i);
    float n100 = hash13(i + vec3(1.0, 0.0, 0.0));
    float n010 = hash13(i + vec3(0.0, 1.0, 0.0));
    float n110 = hash13(i + vec3(1.0, 1.0, 0.0));
    float n001 = hash13(i + vec3(0.0, 0.0, 1.0));
    float n101 = hash13(i + vec3(1.0, 0.0, 1.0));
    float n011 = hash13(i + vec3(0.0, 1.0, 1.0));
    float n111 = hash13(i + vec3(1.0, 1.0, 1.0));
    float x00 = mix(n000, n100, u.x);
    float x10 = mix(n010, n110, u.x);
    float x01 = mix(n001, n101, u.x);
    float x11 = mix(n011, n111, u.x);
    return mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}

// 频率钳制的 fbm：fp 是一个像素在 p 坐标下的覆盖尺寸。
// 某个倍频的波长小于约 2 个像素时，用它的均值 0.5 代替，避免远处闪烁。
float fbm2(vec2 p, float fp) {
    float sum = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    float norm = 0.0;
    for (int i = 0; i < 5; i++) {
        float w = 1.0 - smoothstep(0.22, 0.5, freq * fp);
        sum += amp * mix(0.5, vnoise2(p * freq), w);
        norm += amp;
        amp *= 0.5;
        freq *= 2.03;
    }
    return sum / norm;
}

// 3 个倍频的平滑 fbm（大块污渍用，避免迷彩状斑块）
float fbm2s(vec2 p, float fp) {
    float sum = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    float norm = 0.0;
    for (int i = 0; i < 3; i++) {
        float w = 1.0 - smoothstep(0.22, 0.5, freq * fp);
        sum += amp * mix(0.5, vnoise2(p * freq), w);
        norm += amp;
        amp *= 0.45;
        freq *= 2.1;
    }
    return sum / norm;
}

float fbm3(vec3 p, float fp) {
    float sum = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    float norm = 0.0;
    for (int i = 0; i < 4; i++) {
        float w = 1.0 - smoothstep(0.22, 0.5, freq * fp);
        sum += amp * mix(0.5, vnoise3(p * freq), w);
        norm += amp;
        amp *= 0.5;
        freq *= 2.07;
    }
    return sum / norm;
}

// 单个倍频的可见度（按像素覆盖淡出），用于细节纹理和小几何
float lodFade(float wavelength, float fp) {
    return 1.0 - smoothstep(0.5, 1.4, fp / max(wavelength, 1e-5));
}

// ---- 变换与重复 ----
vec2 rot2(vec2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return vec2(c * p.x - s * p.y, s * p.x + c * p.y);
}

// 居中重复：返回 [-s/2, s/2]
float rep(float x, float s) {
    return x - s * round(x / s);
}

// ---- SDF 基本体 ----
float sdBox3(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sdBox2(vec2 p, vec2 b) {
    vec2 q = abs(p) - b;
    return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0);
}

// 十二条棱都做 45° 倒角的盒子（c = 倒角宽度）
float sdChamferBox(vec3 p, vec3 b, float c) {
    float d = sdBox3(p, b);
    vec3 a = abs(p);
    float e1 = a.x + a.y - (b.x + b.y - c);
    float e2 = a.y + a.z - (b.y + b.z - c);
    float e3 = a.z + a.x - (b.z + b.x - c);
    return max(d, max(e1, max(e2, e3)) * 0.70710678);
}

// 2D 倒角矩形（截面用）
float sdChamferBox2(vec2 p, vec2 b, float c) {
    float d = sdBox2(p, b);
    vec2 a = abs(p);
    return max(d, (a.x + a.y - (b.x + b.y - c)) * 0.70710678);
}

float sdRoundBox3(vec3 p, vec3 b, float r) {
    vec3 q = abs(p) - b + vec3(r);
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0) - r;
}

float sdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - r;
}

float sdSeg2(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a;
    vec2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

// 竖直圆柱（半径 r，半高 h），中心在原点
float sdCylY(vec3 p, float r, float h) {
    vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r, h);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}

// 沿 X 轴的圆柱
float sdCylX(vec3 p, float r, float h) {
    vec2 d = abs(vec2(length(p.yz), p.x)) - vec2(r, h);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}

// 沿 Z 轴的圆柱
float sdCylZ(vec3 p, float r, float h) {
    vec2 d = abs(vec2(length(p.xy), p.z)) - vec2(r, h);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}

float sdTorus(vec3 p, float R, float r) {
    vec2 q = vec2(length(p.xz) - R, p.y);
    return length(q) - r;
}

// 工字钢截面（2D）：半高 h、翼缘半宽 w、翼缘厚 tf、腹板半厚 tw
float sdIBeam2(vec2 p, float h, float w, float tf, float tw) {
    vec2 a = vec2(p.x, abs(p.y));
    float flange = sdBox2(a - vec2(0.0, h - tf), vec2(w, tf));
    float web = sdBox2(p, vec2(tw, h));
    return min(flange, web);
}

float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// 带材质 id 的并集
vec2 opU(vec2 a, float d, float m) {
    return (d < a.x) ? vec2(d, m) : a;
}

// 细杆抗锯齿：半径至少为 0.55 个像素覆盖，返回加粗后的半径
float aaRadius(float r, float lod) {
    return max(r, 0.55 * lod);
}
